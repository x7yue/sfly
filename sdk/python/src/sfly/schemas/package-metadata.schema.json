{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9][0-9A-Za-z.+_!-]*$"
    },
    "requires_python": {
      "type": "string",
      "minLength": 1
    },
    "requires_sdk": {
      "type": "string",
      "pattern": "^\\s*(?:~=|==|!=|<=|>=|<|>)\\s*[0-9]+(?:\\.[0-9]+)*(?:\\s*,\\s*(?:~=|==|!=|<=|>=|<|>)\\s*[0-9]+(?:\\.[0-9]+)*)*\\s*$"
    },
    "nodes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "entry": {
            "type": "string",
            "pattern": "^[A-Za-z_][\\w.]*:[A-Za-z_]\\w*$"
          },
          "inputs": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "object"
              },
              "properties": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              },
              "required": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "order": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "type",
              "properties"
            ],
            "additionalProperties": {}
          },
          "outputs": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "object"
              },
              "properties": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              },
              "required": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "order": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "type",
              "properties"
            ],
            "additionalProperties": {}
          },
          "metrics": {
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                },
                "unit": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "gauge",
                    "counter"
                  ]
                },
                "description": {
                  "type": "string"
                },
                "labels": {
                  "maxItems": 3,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                  }
                }
              },
              "required": [
                "name",
                "unit",
                "kind"
              ],
              "additionalProperties": false
            }
          },
          "charts": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "line",
                    "area",
                    "bar",
                    "stat"
                  ]
                },
                "metrics": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                  }
                }
              },
              "required": [
                "title",
                "type",
                "metrics"
              ],
              "additionalProperties": false
            }
          },
          "primary_metric": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "required": [
          "name",
          "title",
          "entry",
          "inputs",
          "outputs"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "name",
    "version",
    "requires_python",
    "nodes"
  ],
  "additionalProperties": false,
  "title": "sfly 节点包元信息"
}
