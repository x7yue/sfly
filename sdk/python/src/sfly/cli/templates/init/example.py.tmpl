"""示例节点：演示输入与输出、日志、进度、指标和取消。

照着它写自己的节点；不需要时连同 tests/test_example.py 一起删掉。
"""

import time
from typing import Annotated, TypedDict

from sfly import Context, Doc, Metric, node


class CountdownOutputs(TypedDict):
    greeting: Annotated[str, Doc("问候语")]
    ticks: Annotated[int, Doc("实际倒数的步数")]


@node(
    title="倒计时问候",
    metrics=[Metric("remaining", unit="步", kind="gauge", description="剩余步数")],
    primary_metric="remaining",
)
def countdown(
    ctx: Context,
    name: Annotated[str, Doc("要问候的对象")],
    steps: Annotated[int, Doc("倒数的步数，至少 1")] = 3,
    interval: Annotated[float, Doc("每步等待的秒数")] = 0.1,
) -> CountdownOutputs:
    """倒数 steps 步（每步 interval 秒）后问候 name。

    除 ctx 以外的参数都是输入，类型注解决定参数表单；输出由返回类型（TypedDict）声明。
    """
    if steps < 1:
        # 失败就抛异常，消息里写清原因和参数值。
        raise ValueError(f"steps 必须大于 0，收到 {steps}")
    ctx.log.info("开始倒计时：%d 步", steps)
    try:
        for done in range(1, steps + 1):
            # 取消或超时时会在这里抛出 sfly.Cancelled（BaseException 的子类）：
            # 捕获异常时写 except Exception，让它继续往外传。
            time.sleep(interval)
            ctx.progress(done, steps, f"第 {done} 步")
            ctx.metric("remaining", steps - done)
    finally:
        # 清理代码放在 finally / with 里，被取消时也会执行。
        ctx.log.info("倒计时结束")
    return {"greeting": f"你好，{name}", "ticks": steps}
