	"narrative": {
		"northStar": "夜班控制室",
		"overview": "sfly 的界面是一间深夜值守的控制室：整面炭灰、没有色偏，屏幕安静到只剩下正在发生的事。唯一会亮的是青色——它只属于「执行中」、键盘焦点和调度连线；成功、失败、等待各有固定的颜色与形状，异常因此一眼可见。密度接近 IDE，层级靠表面明度台阶和 1px 描边建立；组件手感紧凑、克制，像工具。",
		"keyCharacteristics": [
			"只做深色，炭灰无色偏的五级表面台阶",
			"青色是稀缺信号：执行中、焦点环、调度连线，别无他用",
			"严格的状态语法：颜色 + 形状共同编码",
			"IDE 级密度，数字一律等宽",
			"节点卡片是贯穿全产品的基本单元"
		],
		"rules": [
			{
				"name": "The Scarce Cyan Rule",
				"body": "青色只表示执行中、键盘焦点、调度连线。",
				"section": "colors"
			},
			{
				"name": "The One White Rule",
				"body": "每屏最多一个 primary 白色按钮。",
				"section": "colors"
			},
			{
				"name": "The Status-Only Color Rule",
				"body": "彩色只在表达状态时出现。",
				"section": "colors"
			},
			{
				"name": "The Fixed Scale Rule",
				"body": "只有 11 / 12 / 13 / 14 / 16 / 22 六档字号。",
				"section": "typography"
			},
			{
				"name": "The Tabular Rule",
				"body": "所有数字等宽。",
				"section": "typography"
			},
			{
				"name": "The Tonal Depth Rule",
				"body": "层级用表面台阶表达；阴影只属于浮层。",
				"section": "elevation"
			},
			{
				"name": "The No-Glow Rule",
				"body": "不用零偏移的彩色发光。",
				"section": "elevation"
			}
		],
		"dos": [
			"Do 用表面台阶和 1px 描边建立层级，阴影只给浮层。",
			"Do 让状态同时用颜色和形状表达，并使用统一的状态组件。",
			"Do 把数字、ID、耗时、版本写成等宽。",
			"Do 在高风险对话框里写清后果，dismiss 按钮用「继续运行」这类动作名。",
			"Do 保证 fg-3 及以上的文字在所在表面上 ≥ 4.5:1，不在文字上再叠不透明度。"
		],
		"donts": [
			"Don't 用青色表示选中、链接或强调。",
			"Don't 在一屏放第二个白色实心按钮。",
			"Don't 给图表线、零值统计或装饰着状态色。",
			"Don't 写规定以外的字号、圆角或色值。",
			"Don't 用 11px 写成句的说明文字。",
			"Don't 做浅色主题或移动端布局。"
		]
	}
}
