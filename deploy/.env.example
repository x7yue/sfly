# 复制为 .env 后修改。其余可选配置见 apps/server/src/main.ts 顶部注释，按需加到 docker-compose.yml。
# 控制面启动时检查这里的值（地址、名单、数字都检查）：写错的写明是哪个变量、要求，数值类的还写填的值（最多 12 个字符），一次报完，控制面不启动；
# 报错里只有数值类的回显填的值：地址、名单、代理、数据库地址、密码一律不回显，只说是哪个变量、第几项、哪里不对（常有把别的变量的值误填进来的）。
# 一处例外是数据目录（容器里是 /data，挂着 sfly-data 卷；直接运行控制面的用环境变量 SFLY_DATA_DIR 指定）：它写不了时（控制面启动时试写一次），
# 说明里写它的完整路径，启动输出和 `docker compose logs` 里都看得到，所以不要把要保护的东西写进目录的路径。

# 控制面版本（镜像标签）。建议固定为具体版本（例如 0.0.1），并与 Agent 版本一致。助手和工作台镜像（assistant profile）同一个标签。
SFLY_VERSION=latest

# PostgreSQL 连接串（必填），通常是 postgres:// 或 postgresql:// 开头。数据库在容器外时不要写 127.0.0.1，写数据库主机的地址。
# 连接库（pg）解析不了的写法（端口不是数字、写了多个主机……）启动失败；Unix 套接字的写法也行（容器里要把套接字目录挂进来）。
DATABASE_URL=postgres://sfly:change-me@db.internal:5432/sfly

# Agent 访问控制面 HTTP 端口的地址（必填）：带协议和主机的 http 或 https 地址，不带用户名密码、? 和 #（反向代理把控制面放在路径
# 前缀下时可以带路径，例如 https://corp.example.com/sfly）。少写协议（sfly.internal:8080）启动失败。
SFLY_PUBLIC_URL=http://sfly.internal:8080

# Agent 访问 Agent 网关（gRPC）的地址（可选）：install.sh 把它写进 agent.env。留空时取 SFLY_PUBLIC_URL 的主机加端口 50051（容器里
# 监听的端口：控制面看不到下面 SFLY_GRPC_PORT 的宿主机端口映射）。所以改了 SFLY_GRPC_PORT、或者网关前面有别的地址时要设它。
# 写法同上，另外不带路径，例如 http://sfly.internal:50051。
SFLY_PUBLIC_GRPC_URL=

# Agent 共享令牌（Agent 连控制面用的，不是个人令牌）；设置后令牌不对的 Agent 被拒绝。用随机串生成，例如 `openssl rand -hex 24`：
# 控制面在数据库里存它的 SHA-256（不加盐），对高熵的随机串够用，对人设的弱口令不够。
SFLY_AGENT_TOKEN=

# 下发给所有 Agent 的镜像（可选；留空时 Agent 用 uv 的官方来源）：http 或 https 地址，没写协议启动失败；内网、离线的部署用共享目录
# 做镜像时，PyPI 镜像可以写 file:// 地址或绝对路径，GitHub Release 镜像可以写 file:// 地址。下面是中科大镜像。
SFLY_PYPI_MIRROR=https://mirrors.ustc.edu.cn/pypi/simple
SFLY_GITHUB_RELEASE_MIRROR=https://mirrors.ustc.edu.cn/github-release

# 允许哪些来源的页面在浏览器里跨域调用控制面的 API（用户自建的页面，ADR 0022），逗号分隔。
# 留空时允许所有来源：没有登录，内网用户在浏览器里打开的任何网页都能调用他访问得到的控制面，包括触发和取消运行。
# 不放心时收窄成名单，名单之外的页面被浏览器拦下；控制台自己和命令行不受影响。
SFLY_CORS_ORIGINS=
# SFLY_CORS_ORIGINS=https://dash.example.com,http://localhost:5173

# 登录限速用的来源地址（可选）：控制面在反向代理后面时设置。每个取值的意思（详见 README「登录与反向代理」）：
#   不设置（空、false、0）  不看 X-Forwarded-For，来源地址是 TCP 对端；在反向代理后面这样配，所有人是同一个来源地址
#                           （一个人输错很多次，这个地址上的所有人都被限速）。
#   代理的地址段（推荐）    对端在段里才信它带来的 X-Forwarded-For，取可信代理之前的那个地址；直连的客户端写什么都不作数。
#   代理的层数 1（或 true）、2……  不管对端是谁，跳过右边这几个地址：控制面的端口只能经代理访问。层数要和实际一致：
#                           配多了会取到客户端自己写的地址（限速被伪造的来源绕过），配少了（两层代理只写 1）所有人落在同一个限速桶里。
# SFLY_TRUST_PROXY=127.0.0.1,10.0.0.0/8
# SFLY_TRUST_PROXY=1

# 初始管理员（SFLY_ADMIN_LOGIN、SFLY_ADMIN_PASSWORD）有意不在 docker-compose.yml 里传：库里没有任何用户时，控制面在启动日志里打印一次性的
# 初始化码（docker compose logs sfly），用它在 /setup 页建第一个平台管理员；密码不要写进 .env（它是一份留在宿主机上的明文文件）。
# 自动化部署一定要用环境变量建时，在 docker-compose.override.yml 里给 sfly 服务的 environment 加这两项（要一起给，只在库里没有任何
# 用户时生效）。

# 助手（会话功能，ADR 0027）。默认关闭：下面两项缺一项（或密钥太短）时，会话的写接口（建会话、发话、停止）返回 503
# assistant_not_configured，读接口和其余功能不受影响；原因写在控制面的启动日志和会话列表的就绪状态里，不会静默地关着。
# 用 compose 起助手和工作台：docker compose --profile assistant up -d（步骤见 README「助手和工作台」）；不带 --profile 时只有控制面。
# 助手服务的地址（http 或 https，控制面要连得到）。用 assistant profile 时写 http://sfly-assistant:8090（compose 里的服务名）。
SFLY_ASSISTANT_URL=
# 和助手服务共用的密钥，至少 32 个字符，两边写同一个（compose 里两个服务读的是这一个变量），例如 `openssl rand -hex 24`（48 个字符）。
# 短于 32 个字符当作没有配置：工作台上的模型在网络上可能连得到助手服务的端口，密钥不能太短。
SFLY_ASSISTANT_SECRET=
# 哪台 Agent 是项目的工作台不在这里设：控制面起来之后，项目管理员用 PUT /projects/default/workbench 登记（存在库里，README「登记工作台」）。
# 没有登记时助手本身开着，但建会话和发话返回 503 assistant_unavailable，会话页写「没有登记工作台」。登记之后控制面只接受 Agent 凭据：
# 共享令牌（SFLY_AGENT_TOKEN）和不带凭据的连接都被拒绝。

# 下面几项只给 assistant profile 用（docker compose --profile assistant）；不带这个 profile 时不读。
# 上面的 SFLY_PUBLIC_URL 写浏览器看到的地址；工作台容器里也要连得到它（给 sfly 服务加同名网络别名，或给工作台加 extra_hosts：README「助手和工作台」）。
# 工作台容器里那台 Agent 的名字（管理员按这个名字签发凭据、再登记它作项目的工作台）；不写就是 workbench。
SFLY_WORKBENCH_NAME=workbench
# 工作台 Agent 自己的 Agent 凭据（sfly_agt_ 开头；不是上面的共享令牌 SFLY_AGENT_TOKEN，只对 SFLY_WORKBENCH_NAME 这个名字有效）：
# 控制面起来、登录之后按名字签发：sfly api POST /projects/default/agents/<名字>/credentials，响应里的 token 只显示这一次。只传给工作台这一个服务。
SFLY_WORKBENCH_TOKEN=
# 助手用的模型：<提供方>/<模型 id>，和模型文件里 providers 下的名字、models 里的 id 对上，末尾可以带思考强度（:high）。
# 不设时助手服务照常起来，页面上写没有配置模型。
SFLY_ASSISTANT_MODEL=
# 模型文件在宿主机上的路径（pi 的 models.json 格式，不写密钥；相对路径从 docker-compose.yml 所在目录算），只读挂进助手容器。
# 文件不存在时 docker compose 报错，不会替你建一个同名的目录。
SFLY_ASSISTANT_MODELS_FILE=./assistant-models.json
# 模型文件里 "$MODEL_API_KEY" 引用的密钥，只传给助手容器；别的变量名在 docker-compose.override.yml 里给 sfly-assistant 的 environment 加。
MODEL_API_KEY=

# 保留期、各种上限和登录的空闲期限（可选；留空用默认值）。数值类的设置在控制面启动时就检查：不是数、不是有限的数、
# 超出范围的，写明变量名、填的原文和范围，一次报完，控制面不启动（不会启动之后才悄悄出错）。
# 日志和产物的保留天数：运行结束超过这么久后清理。大于 0、最大 36500（约 100 年），默认 30，可以带小数。
# 不想清理就填 36500，没有别的「永不清理」的写法。
SFLY_RETENTION_DAYS=
# 指标的保留天数：整天超过保留期的指标分区自动删除。范围同上，默认 30。
SFLY_METRIC_RETENTION_DAYS=
# 单个任务的上限，单位 MB（可以带小数），换算成字节后要在 1 到 9007199254740991（2^53 − 1，约 8 PiB）之间；
# 日志超出部分截断（默认 200），产物合计超出时任务失败（默认 1024），指标数据超出后停止写入（默认 50）。
SFLY_LOG_LIMIT_MB=
SFLY_ARTIFACT_LIMIT_MB=
SFLY_METRIC_LIMIT_MB=
# 登录的空闲期限，单位小时（可以带小数）：这么久没有用过的登录失效，用着就顺延。2 分钟（写 0.0334 或更大）到 876000（100 年），
# 默认 12。下限是登录续期间隔（60 秒）的两倍：期限比这短，一直在用的登录也会过期。期限从最近一次续期算起、不是从最近一次使用
# 算起（续期最多每 60 秒一次），所以登录最多比写的期限早 60 秒失效（下限 2 分钟时最多早一半）；一直在用的登录不会过期。
SFLY_LOGIN_IDLE_HOURS=

# 宿主机端口：1 到 65535 的整数。这两个变量只进 docker-compose.yml 的端口映射，控制面自己看不到、不检查：`abc`、`70000`、
# `-1`、`8080.0` 这样的值 docker compose 会报错（invalid hostPort）；`0`（让 Docker 随机挑一个宿主机端口，对部署没有用）和
# `+8080`（当成 8080）它不报错。容器里监听的端口固定是 8080 和 50051，不用改。
SFLY_HTTP_PORT=8080
SFLY_GRPC_PORT=50051
