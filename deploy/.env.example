# 复制为 .env 后修改。其余可选配置见 apps/server/src/main.ts 顶部注释，按需加到 docker-compose.yml。

# 控制面版本（镜像标签）；默认 latest。
SFLY_VERSION=0.1.0

# PostgreSQL 连接串（必填）。数据库在容器外时不要写 127.0.0.1，写数据库主机的地址。
DATABASE_URL=postgres://sfly:change-me@db.internal:5432/sfly

# Agent 访问控制面 HTTP 端口的地址（必填）。
SFLY_PUBLIC_URL=http://sfly.internal:8080

# Agent 共享注册令牌；设置后令牌不对的 Agent 被拒绝。
SFLY_AGENT_TOKEN=

# 宿主机端口。
SFLY_HTTP_PORT=8080
SFLY_GRPC_PORT=50051
