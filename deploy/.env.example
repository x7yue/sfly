# 复制为 .env 后修改。其余可选配置见 apps/server/src/main.ts 顶部注释，按需加到 docker-compose.yml。
# 控制面启动时检查这里的值（地址、名单、数字都检查）：写错的写明是哪个变量、填的值和要求，一次报完，控制面不启动；
# 带密码的值（数据库地址、带用户名密码的地址）不会出现在报错里。

# 控制面版本（镜像标签）。建议固定为具体版本（例如 0.0.1），并与 Agent 版本一致。
SFLY_VERSION=latest

# PostgreSQL 连接串（必填），postgres:// 或 postgresql:// 开头。数据库在容器外时不要写 127.0.0.1，写数据库主机的地址。
DATABASE_URL=postgres://sfly:change-me@db.internal:5432/sfly

# Agent 访问控制面 HTTP 端口的地址（必填）：带协议和主机的 http 或 https 地址，不带用户名密码、? 和 #（反向代理把控制面放在路径
# 前缀下时可以带路径，例如 https://corp.example.com/sfly）。少写协议（sfly.internal:8080）启动失败。
SFLY_PUBLIC_URL=http://sfly.internal:8080

# Agent 共享令牌（Agent 连控制面用的，不是个人令牌）；设置后令牌不对的 Agent 被拒绝。用随机串生成，例如 `openssl rand -hex 24`：
# 控制面在数据库里存它的 SHA-256（不加盐），对高熵的随机串够用，对人设的弱口令不够。
SFLY_AGENT_TOKEN=

# 下发给所有 Agent 的镜像（可选；留空时 Agent 用 uv 的官方来源）：http 或 https 地址，没写协议启动失败。下面是中科大镜像。
SFLY_PYPI_MIRROR=https://mirrors.ustc.edu.cn/pypi/simple
SFLY_GITHUB_RELEASE_MIRROR=https://mirrors.ustc.edu.cn/github-release

# 允许哪些来源的页面在浏览器里跨域调用控制面的 API（用户自建的页面，ADR 0022），逗号分隔。
# 留空时允许所有来源：没有登录，内网用户在浏览器里打开的任何网页都能调用他访问得到的控制面，包括触发和取消运行。
# 不放心时收窄成名单，名单之外的页面被浏览器拦下；控制台自己和命令行不受影响。
SFLY_CORS_ORIGINS=
# SFLY_CORS_ORIGINS=https://dash.example.com,http://localhost:5173

# 登录限速用的来源地址（可选）：控制面在反向代理后面时设置。每个取值的意思（详见 README「登录与反向代理」）：
#   不设置（空、false、0）  不看 X-Forwarded-For，来源地址是 TCP 对端；在反向代理后面这样配，所有人是同一个来源地址
#                           （一个人输错很多次，这个地址上的所有人都被限速）。
#   代理的地址段（推荐）    对端在段里才信它带来的 X-Forwarded-For，取可信代理之前的那个地址；直连的客户端写什么都不作数。
#   代理的层数 1（或 true）、2……  不管对端是谁，跳过右边这几个地址：控制面的端口只能经代理访问。层数要和实际一致：
#                           配多了会取到客户端自己写的地址（限速被伪造的来源绕过），配少了（两层代理只写 1）所有人落在同一个限速桶里。
# SFLY_TRUST_PROXY=127.0.0.1,10.0.0.0/8
# SFLY_TRUST_PROXY=1

# 助手（会话功能，ADR 0027）。默认关闭：下面两项缺一项（或密钥太短）时，会话的写接口（建会话、发话、停止）返回 503
# assistant_not_configured，读接口和其余功能不受影响；原因写在控制面的启动日志和会话列表的就绪状态里，不会静默地关着。
# 助手服务的地址（http 或 https，控制面要连得到）。
SFLY_ASSISTANT_URL=
# 和助手服务共用的密钥，至少 32 个字符，两边写同一个，例如 `openssl rand -hex 24`（48 个字符）。
# 短于 32 个字符当作没有配置：工作台上的模型在网络上可能连得到助手服务的端口，密钥不能太短。
SFLY_ASSISTANT_SECRET=
# 哪台 Agent 是工作台（写 Agent 的名字；Agent 要在线、属于项目，并上报了能力端口）。没写、或这台 Agent 不在线时，
# 助手本身开着，但建会话和发话返回 503 assistant_unavailable，原因写明是工作台没设置或不在线。
SFLY_WORKBENCH_AGENT=

# 保留期、各种上限和登录的空闲期限（可选；留空用默认值）。数值类的设置在控制面启动时就检查：不是数、不是有限的数、
# 超出范围的，写明变量名、填的原文和范围，一次报完，控制面不启动（不会启动之后才悄悄出错）。
# 日志和产物的保留天数：运行结束超过这么久后清理。大于 0、最大 36500（约 100 年），默认 30，可以带小数。
# 不想清理就填 36500，没有别的「永不清理」的写法。
SFLY_RETENTION_DAYS=
# 指标的保留天数：整天超过保留期的指标分区自动删除。范围同上，默认 30。
SFLY_METRIC_RETENTION_DAYS=
# 单个任务的上限，单位 MB（可以带小数），换算成字节后要在 1 到 9007199254740991（2^53 − 1，约 8 PiB）之间；
# 日志超出部分截断（默认 200），产物合计超出时任务失败（默认 1024），指标数据超出后停止写入（默认 50）。
SFLY_LOG_LIMIT_MB=
SFLY_ARTIFACT_LIMIT_MB=
SFLY_METRIC_LIMIT_MB=
# 登录的空闲期限，单位小时（可以带小数）：这么久没有用过的登录失效，用着就顺延。2 分钟（写 0.0334 或更大）到 876000（100 年），
# 默认 12。下限是登录续期间隔（60 秒）的两倍：期限比这短，一直在用的登录也会过期。期限从最近一次续期算起、不是从最近一次使用
# 算起（续期最多每 60 秒一次），所以登录最多比写的期限早 60 秒失效（下限 2 分钟时最多早一半）；一直在用的登录不会过期。
SFLY_LOGIN_IDLE_HOURS=

# 宿主机端口：1 到 65535 的整数。这两个变量只进 docker-compose.yml 的端口映射，控制面自己看不到、不检查：`abc`、`70000`、
# `-1`、`8080.0` 这样的值 docker compose 会报错（invalid hostPort）；`0`（让 Docker 随机挑一个宿主机端口，对部署没有用）和
# `+8080`（当成 8080）它不报错。容器里监听的端口固定是 8080 和 50051，不用改。
SFLY_HTTP_PORT=8080
SFLY_GRPC_PORT=50051
