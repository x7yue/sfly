# 复制为 .env 后修改。其余可选配置见 apps/server/src/main.ts 顶部注释，按需加到 docker-compose.yml。

# 控制面版本（镜像标签）。建议固定为具体版本（例如 0.0.1），并与 Agent 版本一致。
SFLY_VERSION=latest

# PostgreSQL 连接串（必填）。数据库在容器外时不要写 127.0.0.1，写数据库主机的地址。
DATABASE_URL=postgres://sfly:change-me@db.internal:5432/sfly

# Agent 访问控制面 HTTP 端口的地址（必填）。
SFLY_PUBLIC_URL=http://sfly.internal:8080

# Agent 共享注册令牌；设置后令牌不对的 Agent 被拒绝。
SFLY_AGENT_TOKEN=

# 下发给所有 Agent 的镜像（可选；留空时 Agent 用 uv 的官方来源）。下面是中科大镜像。
SFLY_PYPI_MIRROR=https://mirrors.ustc.edu.cn/pypi/simple
SFLY_GITHUB_RELEASE_MIRROR=https://mirrors.ustc.edu.cn/github-release

# 允许哪些来源的页面在浏览器里跨域调用控制面的 API（用户自建的页面，ADR 0022），逗号分隔。
# 留空时允许所有来源：没有登录，内网用户在浏览器里打开的任何网页都能调用他访问得到的控制面，包括触发和取消运行。
# 不放心时收窄成名单，名单之外的页面被浏览器拦下；控制台自己和命令行不受影响。
SFLY_CORS_ORIGINS=
# SFLY_CORS_ORIGINS=https://dash.example.com,http://localhost:5173

# 宿主机端口。
SFLY_HTTP_PORT=8080
SFLY_GRPC_PORT=50051
