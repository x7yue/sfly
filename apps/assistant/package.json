{
	"name": "@sfly/assistant",
	"version": "0.5.0",
	"private": true,
	"type": "module",
	"description": "sfly 助手服务：拉起和看管 pi 进程、把 pi 的事件翻成平台的会话事件、执行控制面发来的命令。运行时只依赖 pi，其余打进 main.mjs（scripts/bundle.ts）",
	"scripts": {
		"dev": "tsx src/main.ts",
		"start": "tsx src/main.ts",
		"build:extension": "tsx scripts/build-extension.ts",
		"bundle": "tsx scripts/bundle.ts",
		"typecheck": "tsc -p .",
		"test": "vitest run"
	},
	"dependencies": {
		"@earendil-works/pi-coding-agent": "1.6.0"
	},
	"devDependencies": {
		"@bufbuild/protobuf": "catalog:",
		"@connectrpc/connect": "2.3.0",
		"@connectrpc/connect-node": "2.3.0",
		"@sfly/proto": "workspace:*",
		"@sfly/schema": "workspace:*",
		"@types/node": "^26.0.0",
		"esbuild": "0.28.2",
		"tsx": "^4.23.15",
		"typescript": "^6.0.2",
		"vitest": "^5.1.0",
		"zod": "catalog:"
	}
}
