#!/usr/bin/env bash
# 推送分支前运行结果确定、几十秒内跑完的检查：版本号、生成代码、lint、类型检查。
# 测试、打包冒烟和镜像冒烟在 CI 里跑（合入 main 必须通过，跳不过）：每次推送都重跑一遍全部测试要等几分钟，
# 几个 worktree 同时推送还会互相拖慢、造成偶发失败。推送前想自己跑：`pnpm test`，完整检查 `pnpm check`。
# 由 `pnpm bootstrap` 启用（git config core.hooksPath .githooks）。只推送 tag 或删除远端分支时跳过。
# 先检查分支名：推送的目标引用（remote_ref，不是本地分支名）要用约定的前缀。允许的前缀就是
# docs/agents/branching-and-release.md「分支命名」表第一列的前缀（sfly-std 的 release/std-X.Y.Z 在 release/ 之下），
# 另加 main 和 dev：表是唯一的定义，这里读它，不另写一份（scripts/tests/test_pre_push.py）。
# `--no-verify` 能跳过；要硬拦，得在 GitHub 规则集里加分支名规则。
set -euo pipefail

root=$(git rev-parse --show-toplevel)
branch_doc=docs/agents/branching-and-release.md

# 读「分支命名」表：第一列写成单个 `前缀/…`（前缀是小写字母、数字和连字符），表头和分隔行跳过，
# 单元格里的多余空白、行首缩进都不碍事。读不懂的行（一格里两个前缀、给前缀加粗……）收集起来，推送时明确报错，不静默丢掉。
prefixes=""
unreadable=()
header=1
# shellcheck disable=SC2016 # 反引号是正则里的字面字符（表格里的代码格式），不是命令替换
cell_re='^`([a-z][a-z0-9-]*/)[^`]*`$'
while IFS= read -r row; do
	[[ $row =~ ^[[:space:]]*\| ]] || continue
	cell=${row#*|}
	cell=${cell%%|*}
	cell=${cell#"${cell%%[![:space:]]*}"}
	cell=${cell%"${cell##*[![:space:]]}"}
	if [[ $cell =~ $cell_re ]]; then
		prefixes+="${BASH_REMATCH[1]} "
	elif [[ $cell =~ ^:?-+:?$ ]] || { ((header)) && [[ $cell != *\`* ]]; }; then
		: # 分隔行；表头（表的第一行，第一列没有反引号）
	else
		unreadable+=("$row")
	fi
	header=0
done < <({ sed -n '/^## 分支命名/,/^## /p' "$root/$branch_doc" 2>/dev/null || true; })
prefixes=${prefixes% }

branch_name_allowed() {
	local name=$1 prefix
	[[ $name == main || $name == dev ]] && return 0
	for prefix in $prefixes; do
		[[ $name == "$prefix"?* ]] && return 0
	done
	return 1
}

zero=0000000000000000000000000000000000000000
branches=0
bad=()
while read -r _local_ref local_sha remote_ref _remote_sha; do
	[[ $local_sha == "$zero" || $remote_ref == refs/tags/* ]] && continue
	branches=1
	if [[ $remote_ref == refs/heads/* ]]; then
		if ((${#unreadable[@]})); then
			for row in "${unreadable[@]}"; do
				echo "pre-push：读不懂 ${branch_doc}「分支命名」表的这一行：${row}" >&2
			done
			echo "  表的第一列要写成单个 \`前缀/…\`（前缀是小写字母、数字和连字符；不在一格里写两个前缀，不给前缀加粗），钩子按它读允许的前缀（跳过：git push --no-verify）" >&2
			exit 1
		fi
		if [[ -z $prefixes ]]; then
			echo "pre-push：读不出 ${branch_doc}「分支命名」表里的前缀，没法检查分支名：先把这张表改回「每行第一列是 \`前缀/…\`」的格式（跳过：git push --no-verify）" >&2
			exit 1
		fi
		branch_name_allowed "${remote_ref#refs/heads/}" || bad+=("${remote_ref#refs/heads/}")
	fi
done
if ((${#bad[@]})); then
	for name in "${bad[@]}"; do
		echo "pre-push：分支名 ${name} 不合约定的前缀。" >&2
	done
	echo "  允许的前缀：${prefixes}，另外 main 和 dev（${branch_doc}「分支命名」）。" >&2
	echo "  Cindy worktree 的 cindy/<名字> 分支推送前要改名：git push -u origin HEAD:<前缀>/<描述>，例如 HEAD:chore/small-checks（跳过：git push --no-verify）" >&2
	exit 1
fi
((branches)) || exit 0

cd "$root"
# git 给钩子设置的 GIT_DIR 等变量会被测试启动的 git 子进程继承，让它们作用到这个仓库而不是测试的临时仓库：
# 一次 `git -C <临时目录> init` 就会把共享配置改成 core.bare=true。检查只靠当前目录定位仓库，所以全部去掉。
while IFS= read -r name; do unset "$name"; done < <(git rev-parse --local-env-vars)
if [[ ! -d node_modules ]]; then
	echo "pre-push：这个工作区还没装依赖（新建的 worktree 要单独装），先运行 pnpm bootstrap" >&2
	exit 1
fi
# Node 低于 .node-version 时，pnpm 的版本警告会混进生成代码插件的输出，gen:check 报的是看不出原因的 protobuf 解析错误。
required=$(tr -d '[:space:]' <.node-version)
current=$(node -p 'process.versions.node')
if ((${current%%.*} < required)); then
	echo "pre-push：需要 Node ${required}（.node-version），当前是 ${current}：先切换 Node 版本（例如 nvm use ${required}）" >&2
	exit 1
fi
# 合入 main 后 pnpm-lock.yaml 或 uv.lock 变了、依赖没重装时，后面的 lint 和 typecheck 会报一页 `Cannot find module` 之类的错，看不出原因。
# pnpm 每次安装都把当时的锁文件复制到 node_modules/.pnpm/lock.yaml；uv 的 --check 只比对锁文件和 .venv，不联网。
if ! cmp -s pnpm-lock.yaml node_modules/.pnpm/lock.yaml; then
	echo "pre-push：node_modules 里装的依赖和 pnpm-lock.yaml 不一致（合入 main 或切换分支后常见），先运行 pnpm install" >&2
	exit 1
fi
if ! uv sync --check --offline --all-packages >/dev/null 2>&1; then
	echo "pre-push：.venv 里装的 Python 依赖和 uv.lock 不一致，先运行 uv sync --locked --all-packages" >&2
	exit 1
fi
echo "pre-push：运行 gen:check、lint、typecheck（跳过：git push --no-verify）" >&2
pnpm release:version check >/dev/null
pnpm gen:check
pnpm lint
pnpm typecheck
