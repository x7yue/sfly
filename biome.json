{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!**/routeTree.gen.ts",
			"!packages/proto/src/gen",
			"!sdk/python/src/sfly/schemas",
			"!apps/server/drizzle",
			"!docs/prototype",
			"!docs/proposals",
			"!docs/perf"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"css": {
		"parser": { "tailwindDirectives": true }
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"plugins": ["./biome-plugins/run-view-cache.grit"]
}
