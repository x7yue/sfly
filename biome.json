{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!**/routeTree.gen.ts",
			"!packages/proto/src/gen",
			"!sdk/python/src/sfly/schemas",
			"!packages/client/src/generated",
			"!packages/client/test/contract-parity.ts",
			"!apps/server/drizzle",
			"!docs/prototype",
			"!docs/perf",
			"!biome-plugins/fixtures"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	},
	"overrides": [
		{
			"includes": ["**/test/**", "apps/web/e2e/**"],
			"linter": { "rules": { "suspicious": { "noTemplateCurlyInString": "off" } } }
		}
	],
	"css": {
		"parser": { "tailwindDirectives": true }
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"plugins": [
		"./biome-plugins/run-view-cache.grit",
		"./biome-plugins/e2e-text-editing-keys.grit",
		"./biome-plugins/e2e-fixed-wait.grit",
		"./biome-plugins/no-raw-table.grit",
		"./biome-plugins/tx-callback-pool.grit"
	]
}
