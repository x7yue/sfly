# 依赖与构建产物
node_modules/
dist/
build/
out/
target/
.venv/
venv/
__pycache__/
*.py[cod]

# 环境与密钥
.env
.env.*
!.env.example
*.pem
*.key

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 日志与临时文件
*.log
logs/
!/apps/server/src/logs/
tmp/
# sfly run / sfly.testing 的本地运行目录（例如 std/.sfly）
.sfly/
# 控制面默认数据目录（SFLY_DATA_DIR）
data/
.cache/

# apps/web 的构建、开发与 e2e 产物。写在根目录而不是 apps/web/.gitignore：
# biome 只读根目录的 .gitignore，写在子目录里会被 `pnpm lint` 检查到。
/apps/web/dist-ssr/
/apps/web/*.local
/apps/web/.nitro/
/apps/web/.tanstack/
/apps/web/.wrangler/
/apps/web/.output/
/apps/web/.vinxi/
/apps/web/__unconfig*
/apps/web/todos.json
/apps/web/test-results/
/apps/web/playwright-report/
