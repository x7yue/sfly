		{ "name": "字符串", "value": "abc", "actual": "\"abc\"" },
		{ "name": "空字符串", "value": "", "actual": "\"\"" },
		{ "name": "true", "value": true, "actual": "true" },
		{ "name": "false", "value": false, "actual": "false" },
		{ "name": "null", "value": null, "actual": "null" },
		{ "name": "空数组", "value": [], "actual": "[]" },
		{ "name": "对象", "value": { "a": 1 }, "actual": "{\"a\":1}" },
